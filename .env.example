# CastTrace AI Environment Configuration

# Application
APP_NAME=CastTrace AI
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=casttrace-dev-insecure-secret-key-change-in-production-32bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (SQLite default for development, compatible with PostgreSQL)
DATABASE_URL=sqlite:///./casttrace.db

# Storage (Local private filesystem for original evidence)
STORAGE_DIR=./storage/evidence
MAX_UPLOAD_SIZE_BYTES=10485760

# CORS Origins (JSON list or comma-separated URLs)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
