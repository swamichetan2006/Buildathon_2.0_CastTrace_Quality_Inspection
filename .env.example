# ==============================================================================
# CastTrace AI — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the project root:
#    copy .env.example .env
# 2. For local development, the default values are pre-configured to work out of the box.
# 3. For production deployment, set APP_ENV=production, APP_DEBUG=false, and generate
#    a cryptographically secure SECRET_KEY (see command below).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Core & Runtime
# ------------------------------------------------------------------------------
APP_NAME=CastTrace AI
# Runtime environment: 'development', 'staging', or 'production'
# In 'production', startup validation enforces:
# - APP_DEBUG must be false
# - SECRET_KEY must NOT match default dev patterns and must be >= 32 characters
# - BACKEND_CORS_ORIGINS must NOT include wildcard '*'
APP_ENV=development
APP_DEBUG=true

# Server Network Binding
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=INFO
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# 2. Security & Authentication
# ------------------------------------------------------------------------------
# JWT Secret Key (HMAC-SHA256)
# To generate a production secret key:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# WARNING: NEVER commit a real production secret to version control.
SECRET_KEY=casttrace-dev-insecure-secret-key-change-in-production-32bytes-min

# JWT Token Expiration in minutes (480 min = 8 hours shift)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# 3. Database Persistence
# ------------------------------------------------------------------------------
# Primary PostgreSQL Database URL (PostgreSQL 14+ recommended)
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<dbname>
# Note: Special characters in passwords (such as '@', ':', '/') must be URL-encoded (e.g. '@' -> '%40')
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@127.0.0.1:5432/casttrace_dev

# Optional dedicated Test Database URL for running automated pytest suites
TEST_DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@127.0.0.1:5432/casttrace_test

# Legacy SQLite fallback (supported for standalone offline development):
# DATABASE_URL=sqlite:///./casttrace.db

# ------------------------------------------------------------------------------
# 4. Evidence & File Storage
# ------------------------------------------------------------------------------
# Dedicated private evidence storage directory (confined and protected against path traversal)
STORAGE_DIR=./storage/evidence

# Maximum allowed upload size per photo (10485760 bytes = 10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# 5. Machine Learning & Worker Configuration
# ------------------------------------------------------------------------------
# Directory containing ResNet-18 weights (model_best.pt), guard reference, and model_metadata.json
ML_ARTIFACTS_DIR=ml/artifacts
MODEL_METADATA_FILE=model_metadata.json

# Background inference worker polling interval in seconds
WORKER_POLL_INTERVAL=1.0

# ------------------------------------------------------------------------------
# 6. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Allowed origins for HTTP API access. Supports JSON list format or comma-separated string.
# NOTE: Wildcard '*' is strictly forbidden when credentials are enabled or in production.
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# ------------------------------------------------------------------------------
# 7. Generative AI (Google Gemini Quality Intelligence)
# ------------------------------------------------------------------------------
# API Key for Google Generative AI / Gemini API
# Acquire via Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

